{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": "src/",
    "paths": {
      "@/*": ["./src/*"],
      "@/components/*": ["components/*"],
      "@/assets/*": ["assets/*"],
      "@/fonts/*": ["fonts/*"],
      "@/utils/*": ["utils/*"],
      "@/lib/*": ["lib/*"],
      "@/app/*": ["app/*"],
    },
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": [
    "node_modules",
    "src/app/profile/boardSnippets.tsx",
    "src/app/profile/snippets.tsx",
    "src/app/snippets/show.tsx",
    "src/app/boards/[:boardId]/snippets/show.tsx",
    "src/components/profile/profile.tsx",
    "src/components/profile/snippets.tsx",
    "src/components/profile/boardSnippets.tsx",
    "src/components/settings/settings.tsx",
    "src/components/snippets/new.tsx",
    "src/components/snippets/show.tsx"
  ]
}
